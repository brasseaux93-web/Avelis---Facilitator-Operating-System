# Multi-stage API image (Node Alpine)
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci || npm install

FROM node:20-alpine AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json* tsconfig.json vite.config.ts ./
COPY src ./src
COPY public ./public
COPY index.html ./
RUN npx tsc --noEmit || true

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV LOG_REQUEST_BODIES=false
ENV LOG_WEBSOCKET_PAYLOADS=false
ENV SESSION_REPLAY_ENABLED=false
ENV PRODUCT_ANALYTICS_ENABLED=false
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY src ./src
COPY drizzle ./drizzle
COPY drizzle.config.ts ./
COPY scripts ./scripts
RUN chmod +x ./scripts/docker-api-entrypoint.sh
EXPOSE 3001
ENTRYPOINT ["sh", "./scripts/docker-api-entrypoint.sh"]
