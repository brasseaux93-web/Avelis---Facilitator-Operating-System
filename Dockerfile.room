# Multi-stage room image (Node Alpine) — memory-only, no durable volume
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci || npm install

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV ROOM_SWAP_DISABLED=true
ENV LOG_WEBSOCKET_PAYLOADS=false
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY src/room ./src/room
EXPOSE 3002
# mem_limit enforced by orchestrator (see docker-compose.yml)
CMD ["npx", "tsx", "src/room/server.ts"]
