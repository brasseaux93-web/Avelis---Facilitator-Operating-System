# Copy to .env (compose reads it automatically). Never commit .env.
# Generate strong values: openssl rand -hex 32

JWT_SECRET=
ROOM_SHARED_SECRET=
LOCAL_DEV_SIGNING_KEY=
LOCAL_DEV_ENCRYPTION_KEY=

